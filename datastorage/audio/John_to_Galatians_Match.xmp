<?xml version="1.0" encoding="UTF-8"?>
<preset version="1.1">
  <effectrack>

    <!-- 1. Parametric Equalizer -->
    <effect id="ParametricEqualizer">
      <param id="HPEnabled" value="true"/>
      <param id="HPFrequency" value="70.0"/>
      <param id="HPSlope" value="2"/>
      <param id="Band2Enabled" value="true"/>
      <param id="Band2Frequency" value="2200.0"/>
      <param id="Band2Gain" value="2.0"/>
      <param id="Band2Q" value="1.4"/>
      <param id="Band2Type" value="2"/>
      <param id="HighShelfEnabled" value="true"/>
      <param id="HighShelfFrequency" value="4500.0"/>
      <param id="HighShelfGain" value="3.5"/>
      <param id="HighShelfQ" value="0.7"/>
      <param id="GlobalGain" value="0.0"/>
    </effect>

    <!-- 2. Dynamics Processing -->
    <effect id="DynamicsProcessor">
      <param id="CompressorEnabled" value="true"/>
      <param id="CompressorThreshold" value="-22.0"/>
      <param id="CompressorRatio" value="2.0"/>
      <param id="CompressorAttack" value="20.0"/>
      <param id="CompressorRelease" value="120.0"/>
      <param id="CompressorGain" value="0.0"/>
    </effect>

    <!-- 3. Tube-model Saturation -->
    <effect id="TubeModeledCompressor">
      <param id="Drive" value="3.0"/>
      <param id="Blend" value="100.0"/>
      <param id="Output" value="0.0"/>
    </effect>

  </effectrack>
</preset>
